{
  "author": {
    "name": "SForum",
    "url": "https://github.com/keeptrue/sforum"
  },
  "backend": {
    "digest": "16adf115fecab1556b6d82828f4daa459adf9f6e0b29b4b83d1b77271331aa64",
    "entry": "backend/plugin",
    "hostApiVersion": "sforum.host@2",
    "protocolVersion": 2,
    "rpc": "hashicorp-go-plugin"
  },
  "capabilities": [
    "settings.own",
    "net.outbound"
  ],
  "description": "Sign in to this SForum site with a SForum account. Host owns accounts, callback state, PKCE, and sessions; this adapter only proves the remote identity.",
  "id": "sforum.connect",
  "identity": {
    "contractVersion": "sforum.connect.identity@1",
    "providers": [
      {
        "contractVersion": "sforum.connect.auth@1",
        "handler": "sforum.connect.identity",
        "icon": "i-tabler-message-circle-2",
        "id": "sforum.connect.auth",
        "kind": "auth",
        "label": {
          "en-US": "SForum",
          "zh-CN": "SForum"
        },
        "operations": [
          {
            "failurePolicy": "fail_closed",
            "inputSchema": "schemas/start.input.json",
            "name": "registration.start",
            "outputSchema": "schemas/start.output.json",
            "timeoutMs": 5000
          },
          {
            "failurePolicy": "fail_closed",
            "inputSchema": "schemas/complete.input.json",
            "name": "registration.complete",
            "outputSchema": "schemas/auth.complete.output.json",
            "timeoutMs": 5000
          },
          {
            "failurePolicy": "fail_closed",
            "inputSchema": "schemas/start.input.json",
            "name": "login.start",
            "outputSchema": "schemas/start.output.json",
            "timeoutMs": 5000
          },
          {
            "failurePolicy": "fail_closed",
            "inputSchema": "schemas/complete.input.json",
            "name": "login.complete",
            "outputSchema": "schemas/auth.complete.output.json",
            "timeoutMs": 5000
          },
          {
            "failurePolicy": "fail_closed",
            "inputSchema": "schemas/start.input.json",
            "name": "link.start",
            "outputSchema": "schemas/start.output.json",
            "timeoutMs": 5000
          },
          {
            "failurePolicy": "fail_closed",
            "inputSchema": "schemas/complete.input.json",
            "name": "link.complete",
            "outputSchema": "schemas/auth.complete.output.json",
            "timeoutMs": 5000
          },
          {
            "failurePolicy": "fail_closed",
            "inputSchema": "schemas/probe.input.json",
            "name": "provider.probe",
            "outputSchema": "schemas/probe.output.json",
            "timeoutMs": 3000
          }
        ],
        "priority": 100
      }
    ]
  },
  "includes": {
    "admin": "manifest/admin.json",
    "langs": "manifest/langs",
    "settings": "manifest/settings.json"
  },
  "lifecycle": {
    "contractVersion": "sforum.connect.lifecycle@1",
    "disable": {
      "checkpointSchema": "sforum.connect.lifecycle.checkpoint@1",
      "execute": "lifecycle.disable",
      "plan": "lifecycle.disable.plan",
      "progressSchema": "sforum.connect.lifecycle.progress@1"
    },
    "enable": {
      "checkpointSchema": "sforum.connect.lifecycle.checkpoint@1",
      "execute": "lifecycle.enable",
      "plan": "lifecycle.enable.plan",
      "progressSchema": "sforum.connect.lifecycle.progress@1"
    },
    "install": {
      "checkpointSchema": "sforum.connect.lifecycle.checkpoint@1",
      "execute": "lifecycle.install",
      "plan": "lifecycle.install.plan",
      "progressSchema": "sforum.connect.lifecycle.progress@1"
    },
    "rollback": {
      "checkpointSchema": "sforum.connect.lifecycle.checkpoint@1",
      "execute": "lifecycle.rollback",
      "plan": "lifecycle.rollback.plan",
      "progressSchema": "sforum.connect.lifecycle.progress@1"
    },
    "uninstall": {
      "checkpointSchema": "sforum.connect.lifecycle.checkpoint@1",
      "execute": "lifecycle.uninstall",
      "plan": "lifecycle.uninstall.plan",
      "progressSchema": "sforum.connect.lifecycle.progress@1"
    },
    "upgrade": {
      "checkpointSchema": "sforum.connect.lifecycle.checkpoint@1",
      "execute": "lifecycle.upgrade",
      "plan": "lifecycle.upgrade.plan",
      "progressSchema": "sforum.connect.lifecycle.progress@1"
    }
  },
